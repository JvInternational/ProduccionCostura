<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Producción Costura V3</title><script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script><style>
:root{--g:#08776b;--ink:#173b35;--mut:#687873;--line:#dfe8e5}*{box-sizing:border-box}body{margin:0;background:#f3f6f5;font-family:Segoe UI,Arial;color:#192622}.app{display:flex;min-height:100vh}aside{width:225px;background:#101a20;padding:18px;color:#fff}.brand{background:#fff;color:var(--ink);padding:20px 8px;border-radius:8px;text-align:center;font-weight:800}.nav{margin-top:22px;padding:12px;background:#21342f;border-radius:8px}main{width:calc(100% - 225px);padding:26px;max-width:1400px}h1{margin:0;color:#132b27}.sub{color:var(--mut);margin:4px 0 18px}.panel,.kpi{background:#fff;border:1px solid var(--line);border-radius:13px;box-shadow:0 5px 18px #153b3220;padding:17px;margin-bottom:15px}.folio{display:flex;gap:22px;align-items:center;background:#f7faf9;border:1px solid var(--line);border-radius:10px;padding:14px;margin-bottom:16px}.folio b{display:block;font:700 22px Consolas;margin-top:5px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.field{display:grid;gap:5px}label{font-size:10px;color:#71807c;text-transform:uppercase;font-weight:700}input,select{height:40px;border:1px solid var(--line);border-radius:8px;padding:0 10px;background:#fff}.ro{background:#f2f6f5}.actions{display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin-top:17px}button{height:39px;border:0;border-radius:8px;padding:0 16px;font-weight:700;cursor:pointer}.primary{background:var(--g);color:#fff}.primary:disabled{opacity:.55}.secondary{background:#e7efed;color:var(--ink)}#status{font-size:12px;color:var(--mut)}#status.ok{color:var(--g);font-weight:700}#status.err{color:#b42318;font-weight:700}.sum{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.kpi{border-left:4px solid var(--g)}.kpi small{color:var(--mut)}.kpi b{display:block;font-size:22px;margin-top:5px}.wrap{overflow:auto;max-height:420px;border:1px solid var(--line);border-radius:9px}table{border-collapse:collapse;width:100%;font-size:12px}th{position:sticky;top:0;background:#f5f8f7;text-align:left;padding:9px}td{padding:8px;border-top:1px solid #edf1f0;white-space:nowrap}.num{text-align:right}.empty{text-align:center;padding:25px;color:var(--mut)}@media(max-width:800px){.grid{grid-template-columns:1fr 1fr}.folio{flex-direction:column;align-items:flex-start}}@media(max-width:620px){.app{display:block}aside,main{width:100%}main{padding:14px}.grid,.sum{grid-template-columns:1fr}}
</style></head><body><div class="app"><aside><div class="brand">JV International</div><div class="nav">Captura diaria V3</div></aside><main><h1>Producción Costura</h1><div class="sub">Captura conectada a Google Sheets con folio centralizado.</div><section class="panel"><div class="folio"><div><label>Último folio guardado</label><b id="folio">Se asigna al guardar</b></div><svg id="barcode"></svg></div><form id="form"><div class="grid">
<div class="field"><label>Fecha *</label><input id="fecha" type="date" required></div><div class="field"><label>Semana ISO</label><input id="semana" class="ro" readonly></div><div class="field"><label>Nombre Personal *</label><select id="personal" required></select></div><div class="field"><label>Máquina *</label><select id="maquina" required></select></div><div class="field"><label>No. Corte *</label><input id="corte" required></div><div class="field"><label>Estilo *</label><input id="estilo" list="estilos" required><datalist id="estilos"></datalist></div><div class="field"><label>Proceso *</label><select id="proceso" required></select></div><div class="field"><label>Costo unitario *</label><input id="costo" type="number" min="0" step="0.01" required></div><div class="field"><label>Cantidad *</label><input id="cantidad" type="number" min="1" step="1" required></div></div><div class="actions"><button id="guardar" class="primary">Guardar en la nube</button><button type="button" class="secondary" onclick="limpiar()">Limpiar</button><button type="button" class="secondary" onclick="csv()">Exportar sesión CSV</button><span id="status">Listo para capturar.</span></div></form></section><div class="sum"><div class="kpi"><small>Registros de esta sesión</small><b id="kr">0</b></div><div class="kpi"><small>Cantidad de esta sesión</small><b id="kq">0</b></div><div class="kpi"><small>Costo de esta sesión</small><b id="kc">$0.00</b></div></div><section class="panel"><b>Capturas confirmadas en esta sesión</b><div id="tabla"></div></section></main></div><script>
const API="https://script.google.com/macros/s/AKfycbyiN8WA6qxJlK0s3X6trL_-sI6KTseDezjQ-5LWYyBsA2P5NvK5cf8yAeK-KruRaQ3r1A/exec",CAT={"personal": ["CORRIL MACARIO", "ELIUD ARCOS", "ESPINOZA ISABEL", "ESTRADA RAMON", "GARCIA GUSTAVO", "GARCIA RIGOBERTO", "GARCIA VICTOR", "GASPAR CLARA", "HERNANDEZ GUILLERMO", "HERNANDEZ LAURA", "HERNANDEZ NICOLAS", "JUSTO ELISER", "KAREN", "LANDERO JUAN", "LOPEZ SANDRA", "MALDONADO LUIS", "MARCIAL JULIO", "MEJIA ROCIO", "MENDIVIL IZZI", "MONTERO LILIANA", "NAVARRO ROSARIO", "PARRA MIGUEL", "PEDRO PABLO", "PEDRO PABLO FELIX", "PEÑUELAS NIDIA", "COLIMA RITA", "RODRIGO SERRANO", "SANCHEZ CRISTINA", "SANTOS FELIX", "SANTOS FRANSISCO", "ZAMORA SAN JUANA"], "maquinas": ["OVER", "COVER", "TAPE", "SENCILLA"], "operaciones": ["HOMBROS", "CUELLO", "S/C CUELLO", "TAPE", "PEGAR MANGA", "CERRAR COSTADOS", "BASTILLA MANGA", "BASTILLA RUEDO", "BIES CUELLO", "BIES MANGA/SISA", "REMACHES", "1ER HOMBRO", "2DO HOMBRO", "CERRAR PUÑO", "PEGAR PUÑO", "CERRAR BANDAS", "PEGAR BANDA", "CERRAR MANGA", "PEGAR MANGA L/S", "S/C RUEDO", "BIES ESPALDA", "CERRAR Y PEGAR PUÑO", "CLIP", "S/C MANGAS", "DESHEBRADO"], "estilos": ["25", "HH55", "JN02", "JR149", "JR47", "MN01", "NN55"], "precios": [{"e": "JR154", "o": "CERRAR HOMBROS", "c": 0.4}, {"e": "JR154", "o": "PEGAR CUELLO", "c": 0.7}, {"e": "JR154", "o": "S/C CUELLO", "c": 0.4}, {"e": "JR154", "o": "PEGAR MANGA", "c": 0.8}, {"e": "JR154", "o": "CERRAR COSTADOS", "c": 0.9}, {"e": "JR154", "o": "BASTILLA MANGA", "c": 0.7}, {"e": "JR154", "o": "BASTILLA RUEDO", "c": 0.7}, {"e": "JR154", "o": "DESHEBRADO", "c": 0.0}, {"e": "JR154", "o": "CLIP", "c": 1.0}, {"e": "JR154", "o": "CERRAR HOMBROS", "c": 0.4}, {"e": "JR154", "o": "PEGAR CUELLO", "c": 0.7}, {"e": "JR154", "o": "S/C CUELLO", "c": 0.4}, {"e": "JR154", "o": "PEGAR MANGA", "c": 0.8}, {"e": "JR154", "o": "CERRAR COSTADOS", "c": 0.9}, {"e": "JR154", "o": "BASTILLA MANGA", "c": 0.7}, {"e": "JR154", "o": "BASTILLA RUEDO", "c": 0.7}, {"e": "JR154", "o": "DESHEBRADO", "c": 0.0}]};let R=[];const $=x=>document.getElementById(x),clean=v=>String(v??'').trim().replace(/\s+/g,' '),money=v=>new Intl.NumberFormat('es-MX',{style:'currency',currency:'MXN'}).format(v||0);
function options(id,a,t){$(id).innerHTML='<option value="">'+t+'</option>'+a.map(x=>'<option>'+x+'</option>').join('')}function week(v){if(!v)return'';let d=new Date(v+'T12:00:00');d.setDate(d.getDate()+4-(d.getDay()||7));let y=new Date(d.getFullYear(),0,1);return Math.ceil((((d-y)/864e5)+1)/7)}function upd(){$('semana').value=week($('fecha').value)}function cost(){let e=clean($('estilo').value).toUpperCase(),o=clean($('proceso').value).toUpperCase(),m=CAT.precios.filter(x=>x.e===e&&x.o===o);if(m.length)$('costo').value=m[0].c.toFixed(2)}function limpiar(){let f=$('fecha').value,p=$('personal').value;$('form').reset();$('fecha').value=f;$('personal').value=p;upd()}function status(t,c=''){$('status').textContent=t;$('status').className=c}
function render(){$('kr').textContent=R.length;$('kq').textContent=R.reduce((s,x)=>s+x.cantidad,0).toLocaleString('es-MX');$('kc').textContent=money(R.reduce((s,x)=>s+x.costoTotal,0));$('tabla').innerHTML=R.length?'<div class="wrap"><table><thead><tr><th>Folio</th><th>Fecha</th><th>Personal</th><th>Máquina</th><th>Corte</th><th>Estilo</th><th>Proceso</th><th>Costo</th><th>Cantidad</th><th>Total</th></tr></thead><tbody>'+R.slice().reverse().map(x=>`<tr><td><b>${x.folio}</b></td><td>${x.fecha}</td><td>${x.personal}</td><td>${x.maquina}</td><td>${x.corte}</td><td>${x.estilo}</td><td>${x.proceso}</td><td class="num">${money(x.costoUnitario)}</td><td class="num">${x.cantidad}</td><td class="num">${money(x.costoTotal)}</td></tr>`).join('')+'</tbody></table></div>':'<div class="empty">Sin capturas confirmadas en esta sesión.</div>'}
$('form').onsubmit=async e=>{e.preventDefault();let q=Number($('cantidad').value),c=Number($('costo').value);if(!Number.isInteger(q)||q<1)return alert('Cantidad inválida.');let d={fecha:$('fecha').value,semana:+$('semana').value,personal:clean($('personal').value),maquina:clean($('maquina').value),corte:clean($('corte').value),estilo:clean($('estilo').value).toUpperCase(),proceso:clean($('proceso').value).toUpperCase(),costoUnitario:c,cantidad:q},btn=$('guardar');btn.disabled=true;status('Guardando en Google Sheets…');try{let r=await fetch(API,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(d),redirect:'follow'});if(!r.ok)throw Error('HTTP '+r.status);let a=await r.json();if(!a.ok)throw Error(a.error||'Sin confirmación');R.push({...d,folio:a.folio,costoTotal:+a.costoTotal});$('folio').textContent=a.folio;JsBarcode('#barcode',a.folio,{format:'CODE128',displayValue:true,height:42,margin:4,fontSize:14});render();limpiar();status('Captura '+a.folio+' guardada correctamente.','ok')}catch(x){console.error(x);status('No se pudo guardar. Verifica conexión e implementación.','err');alert('Error: '+x.message)}finally{btn.disabled=false}};
function csv(){if(!R.length)return alert('No hay capturas confirmadas.');let h=['Folio','Fecha','Semana','Nombre Personal','Maquina','No. Corte','Estilo','Proceso','Costo Unitario','Cantidad','Costo Total'],rows=R.map(x=>[x.folio,x.fecha,x.semana,x.personal,x.maquina,x.corte,x.estilo,x.proceso,x.costoUnitario,x.cantidad,x.costoTotal]),txt='﻿'+[h,...rows].map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(',')).join('
'),a=document.createElement('a');a.href=URL.createObjectURL(new Blob([txt],{type:'text/csv'}));a.download='Produccion_Costura_Sesion_'+new Date().toISOString().slice(0,10)+'.csv';a.click()}
options('personal',CAT.personal,'Seleccione personal');options('maquina',CAT.maquinas,'Seleccione máquina');options('proceso',CAT.operaciones,'Seleccione proceso');$('estilos').innerHTML=CAT.estilos.map(x=>'<option value="'+x+'">').join('');$('fecha').value=new Date().toISOString().slice(0,10);$('fecha').onchange=upd;$('estilo').onchange=cost;$('proceso').onchange=cost;upd();render();
</script></body></html>
